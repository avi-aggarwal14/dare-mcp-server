# Required: the `__client` cookie value from https://clerk.trydare.com while signed in to trydare.com
# DevTools > Application > Storage > Cookies > https://clerk.trydare.com > __client
DARE_CLIENT_TOKEN=eyJ...

# Refuse any single generation estimated above this many credits. Default 500; 0 disables.
DARE_MAX_CREDITS_PER_CALL=500

# Optional overrides
# DARE_REQUEST_TIMEOUT_MS=120000
# DARE_SERVER_URL=https://api.trydare.com
# DARE_CLERK_FAPI_URL=https://clerk.trydare.com

# Only needed for the optional remote HTTP transport
# DARE_MCP_BEARER_TOKEN=change-me-to-a-long-random-secret
# PORT=3000
