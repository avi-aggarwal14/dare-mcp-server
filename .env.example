# Most people do not need this file.
#
#   npx dare-mcp-server setup
#
# stores your credentials in ~/.dare-mcp/config.json instead. Use environment variables
# when that is not appropriate: CI, containers, or a shared machine.

# The `__client` cookie value from https://clerk.trydare.com while signed in to trydare.com.
# DevTools > Application > Storage > Cookies > https://clerk.trydare.com > __client
# Takes precedence over ~/.dare-mcp/config.json.
DARE_CLIENT_TOKEN=eyJ...

# Refuse any single generation estimated above this many credits. Default 500; 0 disables.
DARE_MAX_CREDITS_PER_CALL=500

# Directories dare_upload_media may read local files from. Empty means local reads are refused.
# DARE_UPLOAD_ROOTS=/Users/you/Movies,/Users/you/Pictures

# Optional overrides
# DARE_CONFIG_DIR=~/.dare-mcp
# DARE_REQUEST_TIMEOUT_MS=120000
# DARE_SERVER_URL=https://api.trydare.com
# DARE_CLERK_FAPI_URL=https://clerk.trydare.com

# Only needed for the optional remote HTTP transport
# DARE_MCP_BEARER_TOKEN=change-me-to-a-long-random-secret
# PORT=3000
